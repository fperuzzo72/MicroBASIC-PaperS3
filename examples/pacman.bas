1 REM ------------------------------------------
2 REM MICROBASIC PACMAN - HARDWARE TEST PROGRAM
3 REM TYPE  SCREEN 2  BEFORE  RUN
4 REM ARROWS TURN, Q QUITS, ESC BREAKS
5 REM GHOST MOVES AT HALF THE PLAYER'S SPEED
6 REM MAZE IS 39x13=507: A STRING CANNOT EXCEED
7 REM 511, AND AN UNDIMMED ONE HOLDS ONLY 32 --
8 REM SO BOTH M$ AND A$ ARE DIMMED BELOW.
9 REM ------------------------------------------
10 DIM M$(507),A$(39)
20 GOSUB 900
30 CLS
40 GOSUB 800
50 PX=2:PY=12:GX=20:GY=2:GC$="."
55 AD=0:AE=0:BD=0:BE=0:GD=0:GE=0:GTOG=0
60 SC=0
65 LOCATE 15,1:PRINT "P A C M A N";
70 GOSUB 750
80 GOSUB 700
90 GOSUB 710
100 T=@T+300
110 IF @T<T THEN GOTO 110
120 T=@T+300
130 GET K
140 IF K=113 THEN GOTO 600
150 IF K=30 THEN BD=0:BE=-1
160 IF K=31 THEN BD=0:BE=1
170 IF K=29 THEN BD=-1:BE=0
180 IF K=28 THEN BD=1:BE=0
190 REM -- TURN IF THE WANTED WAY IS OPEN, ELSE KEEP GOING --
200 CX=PX:CY=PY:DX=BD:DY=BE:GOSUB 500
210 IF OK=1 THEN AD=BD:AE=BE
220 CX=PX:CY=PY:DX=AD:DY=AE:GOSUB 500
230 IF OK=0 THEN GOTO 295
240 LOCATE PX+2,PY+2:PRINT " ";
250 PX=NX:PY=NY
260 IF M$(P,P)="." THEN SC=SC+1:M$(P,P)=" "
270 GOSUB 700
280 GOSUB 750
290 IF SC=TD THEN GOTO 650
295 REM -- THE GHOST ONLY GETS EVERY OTHER TICK --
296 GTOG=1-GTOG
297 IF GTOG=0 THEN GOTO 420
300 REM ---- GHOST: CHASE, NEVER TURN BACK ----
305 AX=SGN(PX-GX):AY=SGN(PY-GY)
310 CX=GX:CY=GY
315 DX=AX:DY=0:GOSUB 520
320 IF OK=1 THEN GOTO 400
325 DX=0:DY=AY:GOSUB 520
330 IF OK=1 THEN GOTO 400
335 R=INT(RND(4))
340 DX=1:DY=0
345 IF R=1 THEN DX=-1
350 IF R=2 THEN DX=0:DY=1
355 IF R=3 THEN DX=0:DY=-1
360 GOSUB 520
365 IF OK=1 THEN GOTO 400
370 DX=-DX:DY=-DY:GOSUB 520
375 IF OK=1 THEN GOTO 400
380 T1=DX:DX=DY:DY=T1:GOSUB 520
385 IF OK=1 THEN GOTO 400
390 DX=-DX:DY=-DY:GOSUB 520
395 IF OK=1 THEN GOTO 400
397 REM DEAD END: TURNING BACK IS THE ONLY WAY OUT
398 DX=-GD:DY=-GE:GOSUB 500
399 IF OK=0 THEN GOTO 420
400 LOCATE GX+2,GY+2:PRINT " ";
405 GX=NX:GY=NY:GC$=M$(P,P):GD=DX:GE=DY
410 GOSUB 710
420 IF GX=PX AND GY=PY THEN GOTO 620
430 GOTO 110
500 REM -- CAN (CX,CY) STEP (DX,DY)? SETS OK,NX,NY,P
505 OK=0
506 IF DX=0 AND DY=0 THEN RETURN
507 NX=CX+DX:NY=CY+DY
508 P=(NY-1)*39+NX
509 IF M$(P,P)<>"#" THEN OK=1
510 RETURN
520 REM -- SAME, BUT THE GHOST MAY NOT TURN BACK
525 OK=0
530 IF DX=-GD AND DY=-GE THEN RETURN
535 GOSUB 500
540 RETURN
600 LOCATE 3,16:PRINT "STOPPED. SCORE ";SC;
610 END
620 LOCATE 3,16:PRINT "CAUGHT! SCORE ";SC;
630 END
650 LOCATE 3,16:PRINT "CLEARED! SCORE ";SC;
660 END
700 LOCATE PX+2,PY+2:PRINT "O";
705 RETURN
710 LOCATE GX+2,GY+2:PRINT "&";
715 RETURN
750 LOCATE 3,2:PRINT "SCORE ";SC;" OF ";TD;"  ";
760 RETURN
800 FOR R=1 TO 13
810 LOCATE 3,R+2
820 PRINT M$((R-1)*39+1,R*39);
830 NEXT
840 RETURN
900 TD=0
910 FOR R=1 TO 13
920 READ A$
930 M$((R-1)*39+1,R*39)=A$
940 NEXT
950 FOR I=1 TO 507
960 IF M$(I,I)="." THEN TD=TD+1
970 NEXT
980 RETURN
990 DATA "#######################################"
991 DATA "#.....................................#"
992 DATA "#.###..####..###......###..####..###..#"
993 DATA "#.###..####..###......###..####..###..#"
994 DATA "#.....................................#"
995 DATA "#.###..####..###......###..####..###..#"
996 DATA "#......####................####.......#"
997 DATA "#.###..####................####..###..#"
998 DATA "#.###............................###..#"
999 DATA "#.........####..........####..........#"
1000 DATA "#.........####..........####..........#"
1001 DATA "#.....................................#"
1002 DATA "#######################################"
