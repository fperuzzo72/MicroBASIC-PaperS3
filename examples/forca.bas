1 REM ------------------------------------------
2 REM FSP MICROBASIC - FORCA
3 REM Roda em qualquer SCREEN: so texto rolando.
4 REM ------------------------------------------
10 DIM P$(16):DIM M$(16):DIM L$(2)
20 GOSUB 500
30 E=0
40 FOR I=1 TO N
50 M$(I,I)="."
60 NEXT
70 PRINT
80 PRINT M$(1,N);"   erros ";E;" de 6"
90 IF E<6 THEN GOTO 120
100 PRINT "ENFORCADO! A palavra era ";P$(1,N)
110 END
120 A=0
130 FOR I=1 TO N
140 IF M$(I,I)="." THEN A=1
150 NEXT
160 IF A=1 THEN GOTO 190
170 PRINT "ACERTOU! ";P$(1,N)
180 END
190 INPUT "LETRA";L$
200 IF LEN(L$)=0 THEN GOTO 190
210 C=ASC(L$(1,1))
220 IF C>=97 AND C<=122 THEN C=C-32
230 A=0
240 FOR I=1 TO N
250 D=ASC(P$(I,I))
260 IF D>=97 AND D<=122 THEN D=D-32
270 IF D<>C THEN GOTO 290
280 M$(I,I)=P$(I,I):A=1
290 NEXT
300 IF A=0 THEN E=E+1
310 GOTO 80
500 REM -- SORTEIA UMA PALAVRA --
510 T=@T
520 R=T-INT(T/8)*8+1
530 FOR I=1 TO R
540 READ P$
550 NEXT
560 N=LEN(P$)
570 RETURN
900 DATA "COMPUTADOR","TECLADO","PROGRAMA","MEMORIA"
910 DATA "DISQUETE","IMPRESSORA","MONITOR","LINGUAGEM"
